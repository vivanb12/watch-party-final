# Copy to `.env` (never commit the real file) and fill in your values.

# --- Supabase (required) -----------------------------------------------------
# Public values, exposed to the browser:
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-side values (same project). The service-role key is SECRET: server only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI movie suggestions (optional) ----------------------------------------
# Any OpenAI-compatible provider that supports the Responses API.
# Leave AI_API_KEY empty to disable the feature (the app shows a friendly message).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_REASONING_EFFORT=low   # only set for reasoning models

# --- Scheduled jobs (optional) ----------------------------------------------
CRON_SECRET=

# --- Database migrations with drizzle-kit (optional) ------------------------
DATABASE_URL=
